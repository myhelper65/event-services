- hosts: role_master
  tasks:

  - name: Create .docker folder
    file:
      path: /home/ubuntu/.docker
      state: directory
      mode: '0755'

  - name: copy the docker config file
    become: yes
    copy: 
      src: $JENKINS_HOME/.docker/config.json
      dest: /home/ubuntu/.docker/config.json

  - name: deploy eventservice application
    shell: |
      helm plugin install https://github.com/hypnoglow/helm-s3.git
      kubectl create ns eventservice-dev
      kubectl delete secret regcred -n eventservice-dev || true
      kubectl create secret generic regcred -n eventservice-dev \
        --from-file=.dockerconfigjson=/home/ubuntu/.docker/config.json \
        --type=kubernetes.io/dockerconfigjson
      AWS_REGION=$AWS_REGION helm repo add stable-eventservice s3://eventservice-helm-charts-tecitlab.org/stable/myapp/
      AWS_REGION=$AWS_REGION helm repo update
      AWS_REGION=$AWS_REGION helm upgrade --install \
        eventservice-app-release stable-eventservice/eventservice_chart \
        --version ${BUILD_NUMBER} \
        --namespace eventservice-dev \
        -f /home/ubuntu/values.yaml
    args:
      executable: /bin/bash